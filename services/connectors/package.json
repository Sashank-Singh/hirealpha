{
  "name": "@hirealpha/connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun test",
    "test:pg": "DATABASE_URL=${DATABASE_URL:-postgres://localhost/hirealpha_connectors_test} bun test tests/postgres.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.16.0",
    "hono": "^4.13.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
