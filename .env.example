# HireAlpha — local secrets (never commit the real values).

# --- Marketing / growth (all optional; the site and app run without them) ---

# Resend: waitlist emails are pushed to this audience on every new signup so
# you can send the launch sequence (welcome, "your number is ready", ship day)
# from the Resend dashboard. Free tier = 100 emails/day + 1 audience.
# Sign up: https://resend.com → Add audience ("HireAlpha waitlist") → copy API key.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Plausible analytics needs NO app env var. It is self-hosted on Coolify at
# https://analytics.hirealpha.chat (see deploy/plausible/README.md). The home
# snippet in index.html already points there with data-domain=hirealpha.chat;
# register that site in the dashboard once and events start flowing.

# --- Stripe billing (set on Coolify for production; billing is auto-gated) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FRIEND=
STRIPE_PRICE_FRIEND_PROMO=
STRIPE_PRICE_FRIEND_ANNUAL=
STRIPE_PRICE_COWORKER=
STRIPE_PRICE_COFOUNDER=
STRIPE_PRICE_BUNDLE=
STRIPE_PRICE_BUNDLE_ANNUAL=
STRIPE_PRICE_ULTRA=
BILLING_ENFORCE=0

# --- Per-user Link agent payments -----------------------------------------
# Long random server secret used to encrypt each user's independent Link auth
# document. Never use a developer Link token or share one auth file globally.
HIREALPHA_VAULT_KEY=
USER_SPEND_MAX_CENTS=20000
# Web/API resource: queue approved work on the isolated browser worker.
HIREALPHA_BROWSER_WORKER=1
# Dedicated 32+ character signer for 10-minute private computer links. Never
# reuse the Vault, session-cookie, database, or internal API secret.
HIREALPHA_SESSION_VIEW_SECRET=
# E2B BYOC control-plane access. Use a dedicated browser template and inject no
# Vault, Link, database, or internal API credentials into the guest environment.
E2B_API_KEY=
E2B_BROWSER_TEMPLATE=
# OpenBao Transit. The token must have only datakey/plaintext and decrypt access
# to the named key; root and recovery tokens never enter Coolify.
OPENBAO_ADDR=
OPENBAO_TOKEN=
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_TRANSIT_KEY=hirealpha-user-deks
# Set only after 1Password issues HireAlpha a partner-owned connection URL.
# Never point this at an operator service-account or shared vault flow.
VITE_ONEPASSWORD_CONNECT_URL=
# Optional local override. Production images install an isolated CLI at /opt.
LINK_CLI_BIN=

# --- LLM / Model serving (GMI Cloud or OpenAI-compatible) -----------------
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=google/gemini-3.7-flash
NUTRITION_MODEL=google/gemini-3.7-flash
NUTRITION_VISION_MODEL=google/gemini-3.7-flash
