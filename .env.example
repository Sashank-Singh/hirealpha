# HireAlpha — local secrets (never commit the real values).

# --- Marketing / growth (all optional; the site and app run without them) ---

# Resend: waitlist emails are pushed to this audience on every new signup so
# you can send the launch sequence (welcome, "your number is ready", ship day)
# from the Resend dashboard. Free tier = 100 emails/day + 1 audience.
# Sign up: https://resend.com → Add audience ("HireAlpha waitlist") → copy API key.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Plausible analytics needs NO env var — the snippet in index.html already
# points at domain `hirealpha.chat`. Just create the site at
# https://plausible.io for that domain and events start flowing. (Or self-host
# Plausible on Coolify for free, then swap the snippet src/data-domain.)

# --- Stripe billing (set on Coolify for production; billing is auto-gated) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FRIEND=
STRIPE_PRICE_FRIEND_PROMO=
STRIPE_PRICE_FRIEND_ANNUAL=
STRIPE_PRICE_COWORKER=
STRIPE_PRICE_COFOUNDER=
STRIPE_PRICE_BUNDLE=
STRIPE_PRICE_BUNDLE_ANNUAL=
STRIPE_PRICE_ULTRA=
BILLING_ENFORCE=0