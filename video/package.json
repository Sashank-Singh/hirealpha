{
  "name": "hirealpha-reel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render PhoneVideo out/promo.mp4 --log=verbose",
    "still": "remotion still PhoneVideo out/still.png --frame=240",
    "render:launch": "remotion render HireAlphaLaunch out/hirealpha-launch-30s.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "still:launch": "remotion still HireAlphaLaunch out/hirealpha-launch-poster.png --frame=230",
    "typecheck": "tsc --noEmit",
    "score": "python3 scripts/score.py",
    "score:versions": "python3 scripts/more_scores.py",
    "render:midnight": "remotion render HireAlphaMidnight out/hirealpha-midnight-30s.mp4 --codec=h264 --crf=18",
    "render:conversation": "remotion render HireAlphaConversation out/hirealpha-conversation-30s.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web": "^0.0.166",
    "typescript": "^5.6.3"
  }
}
