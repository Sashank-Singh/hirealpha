# browser-use/web-ui — Environment Variables
#
# Copy this file to .env and fill in your values.
# In Coolify: set these as environment variables on the resource.
# NEVER commit a .env with real secrets.

# ── Domain ─────────────────────────────────────────────────────────────────
# The public hostname Traefik will serve the UI on.
BROWSER_USE_DOMAIN=browser.hirealpha.chat

# ── LLM API Keys (fill in at least one) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com

GOOGLE_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com

MISTRAL_API_KEY=
MISTRAL_ENDPOINT=https://api.mistral.ai/v1

# Local Ollama (only if you have it running on the same server)
OLLAMA_ENDPOINT=http://localhost:11434

# ── Security ────────────────────────────────────────────────────────────────
# VNC password (6-8 chars). Used by noVNC to authenticate viewer connections.
CHROME_VNC_PASSWORD=changeme

# Optional: Gradio HTTP basic auth (leave blank to disable)
GRADIO_USERNAME=
GRADIO_PASSWORD=

# ── Telemetry ───────────────────────────────────────────────────────────────
# Set to "true" to allow browser-use to send anonymous usage stats upstream.
ANONYMIZED_TELEMETRY=false
