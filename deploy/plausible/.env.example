# Plausible Community Edition — copy to your Coolify resource / .env and fill in.

# REQUIRED
# The public URL of the instance. Must match the domain you give Coolify.
BASE_URL=https://analytics.hirealpha.chat
# At least 64 bytes. Generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# OPTIONAL (leave blank for sensible defaults)

# Encrypts TOTP secrets at rest. Generated from SECRET_KEY_BASE if blank.
# Generate with: openssl rand -base64 32
TOTP_VAULT_KEY=

# true | false | invite_only (default invite_only = only you can register).
DISABLE_REGISTRATION=invite_only

# true | false (default false). Requires SMTP below to deliver the link.
ENABLE_EMAIL_VERIFICATION=false

# Port the plausible container listens on. Coolify routes to this port (8000).
HTTP_PORT=8000

# Email (for password resets and weekly reports). Optional.
# MAILER_ADAPTER=SMTP
# MAILER_EMAIL=analytics@hirealpha.chat
# SMTP_HOST_ADDR=smtp.yourprovider.com
# SMTP_HOST_PORT=587
# SMTP_USER_NAME=your-smtp-user
# SMTP_USER_PWD=your-smtp-password
# SMTP_HOST_SSL_ENABLED=false