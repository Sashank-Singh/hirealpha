# HireAlpha connectors OAuth API (Bun + Hono)
FROM oven/bun:1-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/connectors/package.json services/connectors/bun.lock ./
RUN bun install --frozen-lockfile --production

COPY services/connectors/sql ./sql
COPY services/connectors/src ./src

ENV PORT=8787
ENV NODE_ENV=production
EXPOSE 8787

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8787/healthz || exit 1

CMD ["sh", "-c", "bun run src/db/migrate.ts && bun run src/index.ts"]
