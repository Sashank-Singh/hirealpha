# HireAlpha browser-worker.
#
# Layer order is the deploy speed. Everything expensive and rarely changed —
# the OS packages, the link CLI, the production dependency tree — sits above
# the source copies, so a code change rebuilds only the copies and the final
# user setup (seconds). Appending the source copies after the install is what
# made every worker deploy a full reinstall.
FROM oven/bun:1-slim
WORKDIR /app

# Coolify healthchecks use curl/wget; xvfb/x11vnc/novnc serve the local-browser
# session view. Chromium itself is NOT installed: browser tasks run on the
# managed cloud provider (Kernel), and pulling a Chromium build plus its system
# libraries into this image cost minutes of every deploy for a browser that
# nothing here launches. Local mode (HIREALPHA_ALLOW_LOCAL_BROWSER=1) is an
# incident switch that expects playwright's browsers to be present already; the
# entry script says so rather than failing silently.
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl nodejs npm xvfb x11vnc novnc websockify openbox \
    build-essential python3 python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN bun install --production

# Browser Use connects to Kernel's remote Chromium, so no local browser binary
# is installed. Pin the agent library to keep its Python protocol stable.
RUN python3 -m venv /opt/browser-use \
  && /opt/browser-use/bin/pip install --no-cache-dir "browser-use==0.13.10"

# ---- source (the only layers a normal change invalidates) ----
COPY deploy/browserWorker.ts ./browserWorker.ts
COPY deploy/browserSession.ts ./browserSession.ts
COPY deploy/browserRunner.ts ./browserRunner.ts
COPY deploy/browserVault.ts ./browserVault.ts
COPY deploy/browserJobs.ts ./browserJobs.ts
COPY deploy/browserNetworkPolicy.ts ./browserNetworkPolicy.ts
COPY deploy/agentDriver.ts ./agentDriver.ts
COPY deploy/e2bExecutor.ts ./e2bExecutor.ts
COPY deploy/kernelPage.ts ./kernelPage.ts
COPY deploy/kernelSession.ts ./kernelSession.ts
COPY deploy/browserUseSession.ts ./browserUseSession.ts
COPY deploy/browserUseRunner.py ./browserUseRunner.py
COPY deploy/siteMemory.ts ./siteMemory.ts
COPY deploy/userIdentity.ts ./userIdentity.ts
COPY deploy/challengeDetection.ts ./challengeDetection.ts
COPY deploy/vaultCrypto.ts ./vaultCrypto.ts
COPY deploy/linkWallet.ts ./linkWallet.ts
COPY deploy/userPayments.ts ./userPayments.ts
COPY deploy/onePassword.ts ./onePassword.ts
COPY deploy/browserWorkerEntry.sh ./browserWorkerEntry.sh
COPY services/trust /services/trust
COPY services/tasks /services/tasks
RUN ln -s /app /deploy
RUN chmod +x ./browserWorkerEntry.sh \
  && groupadd --system hirealpha && useradd --system --gid hirealpha --home-dir /tmp/hirealpha hirealpha \
  && mkdir -p /tmp/hirealpha && chown -R hirealpha:hirealpha /tmp/hirealpha

ENV WORKER_HEALTH_PORT=3000
ENV DISPLAY=:99
ENV BROWSER_HEADFUL=1
ENV NODE_ENV=production
ENV BROWSER_USE_PYTHON=/opt/browser-use/bin/python
ENV KERNEL_AGENT_DRIVER=browser-use
EXPOSE 3000 6080
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/healthz || exit 1
# Only health is served over HTTP; jobs come from the approved Postgres queue.
USER hirealpha
CMD ["./browserWorkerEntry.sh"]
