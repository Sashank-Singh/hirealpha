# HireAlpha marketing site (Vite static) + waitlist API (Bun)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM oven/bun:1-slim
WORKDIR /app
# Coolify healthchecks use curl/wget; build-essential+python3 compile the one
# native dep (better-sqlite3 via mem0ai) against this stage's glibc — the alpine
# builder's musl build can never load here (and worker 14b57be proved the recipe).
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl nodejs npm build-essential python3 \
  && rm -rf /var/lib/apt/lists/*
# Headless Chromium for the browser runner (vault tasks): cached permanently
# above the source copies so code changes rebuild in seconds instead of minutes.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN bunx playwright install --with-deps chromium

# Server deps are installed HERE (debian/glibc), not copied from the alpine
# builder: musl-compiled natives cannot load in this runtime, and bun silently
# auto-installed mem0 from its cache instead — where better-sqlite3 was absent,
# which is why every memory search failed with "Cannot find package".
# The /node_modules symlink is load-bearing: services/trust is copied to
# /services (outside /app), and Node/Bun resolution walks UP from the importing
# file — without it, import('mem0ai/oss') never sees /app/node_modules.
COPY package.json package-lock.json ./
RUN bun install --production \
  && ln -s /app/node_modules /node_modules

COPY deploy/web-server.ts ./web-server.ts
COPY deploy/appPreload.ts ./appPreload.ts
COPY deploy/agentReady.ts ./agentReady.ts
COPY deploy/workshop.ts ./workshop.ts
COPY deploy/hire-api.ts ./hire-api.ts
COPY deploy/webSearch.ts ./webSearch.ts
COPY deploy/aiJudge.ts ./aiJudge.ts
COPY deploy/calendarEvents.ts ./calendarEvents.ts
COPY deploy/composioPlugins.ts ./composioPlugins.ts
COPY deploy/timezones.ts ./timezones.ts
COPY deploy/gmailHelpers.ts ./gmailHelpers.ts
COPY deploy/weekRun.ts ./weekRun.ts
COPY deploy/modelJson.ts ./modelJson.ts
COPY deploy/staleCache.ts ./staleCache.ts
COPY deploy/httpCache.ts ./httpCache.ts
COPY deploy/browserVault.ts ./browserVault.ts
COPY deploy/browserRunner.ts ./browserRunner.ts
COPY deploy/vaultCrypto.ts ./vaultCrypto.ts
COPY deploy/onePassword.ts ./onePassword.ts
COPY deploy/userPayments.ts ./userPayments.ts
COPY deploy/linkWallet.ts ./linkWallet.ts
COPY deploy/browserJobs.ts ./browserJobs.ts
COPY deploy/browserNetworkPolicy.ts ./browserNetworkPolicy.ts
COPY deploy/browserSession.ts ./browserSession.ts
COPY deploy/browserWorker.ts ./browserWorker.ts
COPY deploy/certification/envContract.ts ./certification/envContract.ts
COPY deploy/e2bExecutor.ts ./e2bExecutor.ts
COPY deploy/kernelPage.ts ./kernelPage.ts
COPY deploy/kernelSession.ts ./kernelSession.ts
COPY deploy/telemetry.ts ./telemetry.ts
COPY deploy/browserUseSession.ts ./browserUseSession.ts
COPY deploy/browserUseRunner.py ./browserUseRunner.py
COPY deploy/siteMemory.ts ./siteMemory.ts
COPY deploy/userIdentity.ts ./userIdentity.ts
COPY deploy/challengeDetection.ts ./challengeDetection.ts
COPY deploy/agentDriver.ts ./agentDriver.ts
COPY deploy/demoData.ts ./demoData.ts
COPY deploy/demoFixtures.ts ./demoFixtures.ts
COPY deploy/migrate.ts ./migrate.ts
COPY deploy/migrations ./migrations
COPY services/trust /services/trust
COPY services/tasks /services/tasks
COPY spectrum ../spectrum
# hire-api imports the mini-app skill catalog from the frontend tree; only
# src/agents is runtime-safe (pure TS data, no vite/browser deps).
COPY src/agents /src/agents
RUN ln -s /app /deploy
COPY --from=build /app/dist ./dist

ENV PORT=80
ENV STATIC_ROOT=/app/dist
ENV NODE_ENV=production
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=8s --retries=3 \
  CMD curl -fsS http://127.0.0.1/healthz || exit 1

# Migrations run inside web-server.ts after ensureHireSchema (they FK
# hire_users, so they cannot run before the base schema exists).
CMD ["bun", "run", "web-server.ts"]
