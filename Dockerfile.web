# HireAlpha marketing site (Vite static) + waitlist API (Bun)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src
RUN npm run build
RUN npm prune --omit=dev

FROM oven/bun:1-slim
WORKDIR /app
# Coolify healthchecks use curl/wget
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY deploy/web-server.ts ./web-server.ts
COPY deploy/hire-api.ts ./hire-api.ts
COPY deploy/calendarEvents.ts ./calendarEvents.ts
COPY deploy/composioPlugins.ts ./composioPlugins.ts
COPY deploy/timezones.ts ./timezones.ts
COPY deploy/gmailHelpers.ts ./gmailHelpers.ts
COPY deploy/weekRun.ts ./weekRun.ts
COPY deploy/modelJson.ts ./modelJson.ts
COPY deploy/staleCache.ts ./staleCache.ts
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

ENV PORT=80
ENV STATIC_ROOT=/app/dist
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=8s --retries=3 \
  CMD curl -fsS http://127.0.0.1/healthz || exit 1

CMD ["bun", "run", "web-server.ts"]
