# HireAlpha marketing site (Vite static) + waitlist API (Bun)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src
RUN npm run build
RUN npm prune --omit=dev

FROM oven/bun:1-slim
WORKDIR /app
# Coolify healthchecks use curl/wget
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl nodejs npm \
  && rm -rf /var/lib/apt/lists/*
COPY deploy/link-cli-package.json /opt/hirealpha-link/package.json
RUN npm install --prefix /opt/hirealpha-link --omit=dev --ignore-scripts

COPY deploy/web-server.ts ./web-server.ts
COPY deploy/appPreload.ts ./appPreload.ts
COPY deploy/agentReady.ts ./agentReady.ts
COPY deploy/workshop.ts ./workshop.ts
COPY deploy/hire-api.ts ./hire-api.ts
COPY deploy/webSearch.ts ./webSearch.ts
COPY deploy/aiJudge.ts ./aiJudge.ts
COPY deploy/calendarEvents.ts ./calendarEvents.ts
COPY deploy/composioPlugins.ts ./composioPlugins.ts
COPY deploy/timezones.ts ./timezones.ts
COPY deploy/gmailHelpers.ts ./gmailHelpers.ts
COPY deploy/weekRun.ts ./weekRun.ts
COPY deploy/modelJson.ts ./modelJson.ts
COPY deploy/staleCache.ts ./staleCache.ts
COPY deploy/httpCache.ts ./httpCache.ts
COPY deploy/browserVault.ts ./browserVault.ts
COPY deploy/browserRunner.ts ./browserRunner.ts
COPY deploy/vaultCrypto.ts ./vaultCrypto.ts
COPY deploy/onePassword.ts ./onePassword.ts
COPY deploy/userPayments.ts ./userPayments.ts
COPY deploy/linkWallet.ts ./linkWallet.ts
COPY deploy/browserJobs.ts ./browserJobs.ts
COPY deploy/browserNetworkPolicy.ts ./browserNetworkPolicy.ts
COPY deploy/browserSession.ts ./browserSession.ts
COPY deploy/browserWorker.ts ./browserWorker.ts
COPY deploy/e2bExecutor.ts ./e2bExecutor.ts
COPY deploy/agentDriver.ts ./agentDriver.ts
COPY deploy/demoData.ts ./demoData.ts
COPY deploy/demoFixtures.ts ./demoFixtures.ts
COPY deploy/migrate.ts ./migrate.ts
COPY deploy/migrations ./migrations
COPY services/trust /services/trust
COPY spectrum ../spectrum
# hire-api imports the mini-app skill catalog from the frontend tree; only
# src/agents is runtime-safe (pure TS data, no vite/browser deps).
COPY src/agents /src/agents
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Headless Chromium for the browser runner (vault tasks): downloads the
# playwright-matched browser build plus the system libraries it needs.
RUN bunx playwright install --with-deps chromium

ENV PORT=80
ENV STATIC_ROOT=/app/dist
ENV NODE_ENV=production
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=8s --retries=3 \
  CMD curl -fsS http://127.0.0.1/healthz || exit 1

CMD ["sh", "-c", "bun run migrate.ts && exec bun run web-server.ts"]
